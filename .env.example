# AudioX Configuration Example
# Copy this file to .env.local for local development or .env for container deployments

# Optional dedicated media worker URL (e.g. Railway, Render, Fly.io, or VPS)
# Leave blank to process media conversions using the embedded engine
WORKER_URL=
WORKER_SECRET=

# Temporary audio conversion directory
TEMP_DIR=/tmp/audiox

# Converted file retention duration before automatic cleanup (in minutes)
FILE_EXPIRY_MINUTES=30

# Maximum local media file upload limit (in megabytes)
MAX_FILE_SIZE_MB=500

# Queue concurrency (Default: 1 for strictly sequential FIFO processing)
QUEUE_CONCURRENCY=1

# Public application branding
NEXT_PUBLIC_APP_NAME=AudioX
