# AudioX Vercel Environment Configuration
# Dedicated Railway Media Worker Connection

# Production: set to your deployed Railway worker HTTPS URL
# Local development: defaults to http://127.0.0.1:8000
AUDIOX_WORKER_URL=https://audiox-worker-production.up.railway.app

# Shared secret matching WORKER_SECRET configured on Railway
AUDIOX_WORKER_SECRET=your_strong_worker_secret_here
