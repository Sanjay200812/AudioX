# AudioX Vercel Environment Variables
# All media processing runs directly on Vercel Serverless Functions (Python + yt-dlp + static FFmpeg).
# No external Railway or worker servers required.

# Public Application Base URL (optional, defaults to Vercel domain or http://localhost:3000)
NEXT_PUBLIC_APP_URL=https://your-audiox-domain.vercel.app

# ==============================================================================
# Optional External AI API Keys (Server-side only)
# ==============================================================================
GEMINI_API_KEY=
OPENAI_API_KEY=

# ==============================================================================
# Temporary Storage Runtime Settings
# ==============================================================================
# Temporary workspace directory (defaults to /tmp/audiox on Linux/Vercel)
TEMP_DIR=/tmp/audiox
