# AudioX Media Processing Worker Configuration

# Shared secret required for Vercel <-> Worker communication
# Must match AUDIOX_WORKER_SECRET set on Vercel
WORKER_SECRET=your_strong_worker_secret_here

# Runtime listening port (provided automatically by container environment or set for Docker)
PORT=8000

# Temporary workspace directory for yt-dlp & FFmpeg conversions
TEMP_DIR=/tmp/audiox

# Temporary media file retention period before automated cleanup (minutes)
FILE_EXPIRY_MINUTES=30

# Maximum permitted output audio file size (MB)
MAX_FILE_SIZE_MB=500

# Maximum video duration permitted for conversion (minutes)
MAX_VIDEO_DURATION_MINUTES=120

# Optional: comma-separated allowed origins (defaults to * with non-credentialed requests)
ALLOWED_ORIGINS=*
