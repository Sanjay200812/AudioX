# AudioX Vercel & Production Environment Configuration

# External Media Processing Worker (Railway / Render / Docker VPS)
# When deploying AudioX to Vercel, set these to point to your deployed AudioX worker.
AUDIOX_WORKER_URL=https://audiox-worker.up.railway.app
AUDIOX_WORKER_SECRET=your-secure-random-worker-secret-here

# Converted audio file retention duration (minutes, default: 30)
# FILE_EXPIRY_MINUTES=30
