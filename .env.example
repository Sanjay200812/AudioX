# AudioX Production Environment Variables (Vercel + Railway Worker)

# Public Application Base URL (optional, defaults to Vercel domain or http://localhost:3000)
NEXT_PUBLIC_APP_URL=https://your-audiox-domain.vercel.app

# ==============================================================================
# Audio Media Processing Worker Connection (Server-side only)
# ==============================================================================
# Production: set to your deployed media worker HTTPS URL
# Local development: defaults to http://127.0.0.1:8000
AUDIOX_WORKER_URL=https://worker.your-audiox-domain.com

# Shared secret matching WORKER_SECRET configured on the media worker (Server-side only)
AUDIOX_WORKER_SECRET=your_strong_worker_secret_here

# ==============================================================================
# Optional External AI API Keys (Server-side only)
# ==============================================================================
GEMINI_API_KEY=
OPENAI_API_KEY=

# ==============================================================================
# Temporary Storage Runtime Settings
# ==============================================================================
# Temporary workspace directory (defaults to /tmp/audiox)
TEMP_DIR=/tmp/audiox

# Temporary file expiry in minutes (defaults to 30)
FILE_EXPIRY_MINUTES=30
