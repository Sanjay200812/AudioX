# AudioX Environment Configuration
# All environment variables are OPTIONAL. The application will run with defaults if none are set.

# Temporary audio conversion directory (Defaults to OS temporary directory: os.tmpdir()/audiox)
# TEMP_DIR=/tmp/audiox

# Converted audio file retention duration before automatic cleanup (Defaults to 30 minutes)
# FILE_EXPIRY_MINUTES=30

# Maximum local media file upload limit in megabytes (Defaults to 500 MB)
# MAX_FILE_SIZE_MB=500
